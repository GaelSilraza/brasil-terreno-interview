{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Finance": "Host=localhost;Port=55432;Database=finance;Username=finance;Password=finance"
  },
  "TransferLimits": {
    "TimeZoneId": "America/Sao_Paulo",
    "DaytimeStartsAt": "06:00",
    "NighttimeStartsAt": "20:00",
    "DefaultDaytimeMaxAmountPerHour": 5000,
    "DefaultDaytimeMaxAttemptsPerHour": 5,
    "DefaultNighttimeMaxAmountPerHour": 1000,
    "DefaultNighttimeMaxAttemptsPerHour": 3
  },
  "ScheduledTransfers": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "StaleProcessingTimeoutMinutes": 10
  },
  "Outbox": {
    "PollingIntervalSeconds": 1,
    "BatchSize": 500,
    "MaxAttempts": 10
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "finance",
    "Password": "finance",
    "VirtualHost": "/",
    "ExchangeName": "finance.events",
    "DeadLetterExchangeName": "finance.dead-letter",
    "DeadLetterQueueName": "finance.dead-letter",
    "PrefetchCount": 10,
    "ConsumerDispatchConcurrency": 4
  }
}
